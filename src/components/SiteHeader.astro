---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  crumbs?: Crumb[];
}

const { crumbs = [] } = Astro.props;
---

<header class="border-b border-rule">
  <div class="mx-auto flex max-w-2xl items-center justify-between px-6 py-6">
    <a href="/" class="font-display text-lg tracking-tight text-ink no-underline transition-colors duration-150 hover:text-accent">
      Maou Usually Talks
    </a>
    <nav class="flex items-center gap-7 text-sm text-ink-soft">
      <a href="/notes" class="transition-colors duration-150 hover:text-accent">
        notes
      </a>
      
      <a 
        href="https://github.com/daddymaou" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="flex items-center gap-1.5 transition-colors duration-150 hover:text-accent"
        aria-label="GitHub Profile"
      >
        <svg class="h-[14px] w-[14px] fill-current opacity-80" viewBox="0 0 24 24" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
        <span>github</span>
      </a>

      <a 
        href="mailto:daddymaouu@gmail.com" 
        class="flex items-center gap-1.5 transition-colors duration-150 hover:text-accent"
        aria-label="Send Email"
      >
        <svg class="h-[14px] w-[14px] stroke-current fill-none opacity-80" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect width="20" height="16" x="2" y="4" rx="2" />
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
        </svg>
        <span>mail</span>
      </a>
    </nav>
  </div>

  {
    crumbs.length > 0 && (
      <div class="mx-auto max-w-2xl px-6 pb-4 text-sm text-ink-soft">
        {crumbs.map((crumb, i) => (
          <>
            {i > 0 && <span class="mx-1.5">/</span>}
            {crumb.href ? (
              <a href={crumb.href} class="transition-colors duration-150 hover:text-accent">
                {crumb.label}
              </a>
            ) : (
              <span>{crumb.label}</span>
            )}
          </>
        ))}
      </div>
    )
  }
</header>